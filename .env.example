# Copy to .env.local and adjust.

# Required: signs the login cookie. Use a long random string (32+ characters), e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs everyone out. If unset in dev, a random secret is used per server start.
SECRET_COOKIE_PASSWORD=

# Optional: host DM login (user id 0). Log in on the normal form with these credentials.
DM_USERNAME=
DM_PASSWORD=

# Optional: if set, POST /api/register must send the same string as inviteCode
REGISTRATION_SECRET=

# Optional server settings
# PORT=3000
# LISTEN_HOST=0.0.0.0          (127.0.0.1 = this machine only)
# DATABASE_PATH=./vttdatabase.db
# COOKIE_SECURE=true          (force Secure cookies; default: only over https / tunnels)
# ALLOWED_DEV_ORIGINS=         (extra tunnel hostnames, comma-separated)
# ENABLE_HOST_TUNNEL=          (tunnel button; on by default in dev)
# CLOUDFLARED_PATH=            (path to cloudflared.exe if not on PATH)
